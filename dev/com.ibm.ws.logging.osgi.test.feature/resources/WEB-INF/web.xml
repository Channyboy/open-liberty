<!DOCTYPE web-app>
<web-app id="LoggingTestREST" version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
  <display-name>LoggingTest</display-name>
  <description>Logging Test REST endpoint for Liberty server</description>

  <servlet>
    <servlet-name>LoggingTestProxyServlet</servlet-name>
    <servlet-class>com.ibm.ws.logging.osgi.test.feature.LoggingTestProxyServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet-mapping id="ServletMapping_Default">
    <servlet-name>LoggingTestProxyServlet</servlet-name>
    <url-pattern>/*</url-pattern>
  </servlet-mapping>
</web-app>
