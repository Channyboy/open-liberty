<server description="TraceEmitter FAT Test Server - dynamic update adding wsTraceHandler-1.0">

    <include location="../fatTestPorts.xml" />

    <!-- Relative to TraceEmitterServer/server.xml: wsTraceHandler-1.0 is added. The trace
         specification is unchanged so no additional traces are produced. -->
    <featureManager>
        <feature>traceEmitter-1.0</feature>
        <feature>wsTraceHandler-1.0</feature>
    </featureManager>

    <logging traceSpecification="*=info:com.ibm.ws.logging.osgi.fat.traceemitter.*=all" />

</server>
