<server description="WsLogHandler FAT Test Server - Wildcard IDs, level-only dynamic update">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Updated routerThing relative to WsLogHandlerWildcardServer/server.xml:
           Removed:   CWLFA*, CWLFB*W, CWLFC*A, CWLFD*E (all prefix patterns)
           Added:     *E (level-only ERROR, any prefix)
                      *A (level-only AUDIT, any prefix)
                      CWLFH*I (prefix + level INFO, coexists with the level-only forms) -->
    <wsLogHandler routerThing="*E,*A,CWLFH*I" />

</server>
