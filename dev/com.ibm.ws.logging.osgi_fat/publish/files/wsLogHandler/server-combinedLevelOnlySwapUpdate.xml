<server description="WsLogHandler FAT Test Server - Combined IDs, level-only wildcard swapped">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Updated routerThing relative to server-combinedLevelOnlyAddUpdate.xml:
           Retained: CWLFA*     (wildcard - plain prefix)
                     CWLFB0001I (exact ID)
                     CWLFD0003E (exact ID)
           Removed:  *E         (level-only ERROR)
                     CWLFC*A    (wildcard - prefix + level AUDIT)
           Added:    *A         (level-only AUDIT, any prefix; now covers CWLFC audit messages) -->
    <wsLogHandler routerThing="CWLFA*,CWLFB0001I,CWLFD0003E,*A" />

</server>
