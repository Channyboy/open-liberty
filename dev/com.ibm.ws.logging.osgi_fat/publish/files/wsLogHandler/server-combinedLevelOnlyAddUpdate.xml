<server description="WsLogHandler FAT Test Server - Combined IDs, level-only wildcard added">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Updated routerThing relative to WsLogHandlerCombinedServer/server.xml:
           Retained: CWLFA*     (wildcard - plain prefix)
                     CWLFB0001I (exact ID)
                     CWLFC*A    (wildcard - prefix + level AUDIT)
                     CWLFD0003E (exact ID)
           Added:    *E         (level-only ERROR, any prefix; overlaps CWLFA* and CWLFD0003E) -->
    <wsLogHandler routerThing="CWLFA*,CWLFB0001I,CWLFC*A,CWLFD0003E,*E" />

</server>
