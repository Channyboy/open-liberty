<server description="WsLogHandler FAT Test Server - Wildcard IDs, 9 character IDs">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsLogHandler-1.0</feature>
    </featureManager>

    <!-- Wildcards that match 9 character IDs (4 character component code + 4 digits + level):
           CWAB*    plain prefix, any level
           CWAC*W   level-qualified WARNING
           CWAD00*E prefix that includes part of the number range, level-qualified ERROR
         and one wildcard that matches a 10 character ID:
           CWXYZ*A  level-qualified AUDIT -->
    <wsLogHandler routerThing="CWAB*,CWAC*W,CWAD00*E,CWXYZ*A" />

</server>
