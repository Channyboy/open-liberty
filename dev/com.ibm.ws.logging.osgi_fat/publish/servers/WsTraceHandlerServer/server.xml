<server description="WsTraceHandler FAT Test Server">

    <include location="../fatTestPorts.xml" />

    <featureManager>
        <feature>wsTraceHandler-1.0</feature>
    </featureManager>

    <!-- Tr.debug records are only created when the trace spec enables the emitting package. -->
    <logging traceSpecification="*=info:com.ibm.ws.logging.osgi.fat.wstracehandler.*=all" />

</server>
