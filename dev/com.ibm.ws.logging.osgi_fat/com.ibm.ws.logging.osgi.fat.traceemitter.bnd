-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: TraceEmitter FAT Test Bundle
Bundle-Description: FAT test bundle that emits traces at activation, used to test the WsTraceRouter earlierTraces buffer; version=${bVersion}
Bundle-SymbolicName: com.ibm.ws.logging.osgi.fat.traceemitter; singleton:=true

Private-Package: \
    com.ibm.ws.logging.osgi.fat.traceemitter

-includeresource: \
    OSGI-INF/permissions.perm=test-bundles/com.ibm.ws.logging.osgi.fat.traceemitter/resources/OSGI-INF/permissions.perm

-dsannotations: \
    com.ibm.ws.logging.osgi.fat.traceemitter.TraceEmitterService

instrument.disabled: true
