-include= ~../cnf/resources/bnd/bundle.props
bVersion=1.0

Bundle-Name: WsTraceHandler FAT Test Bundle
Bundle-Description: FAT test bundle for WsTraceHandler / WsTraceRouter routing; version=${bVersion}
Bundle-SymbolicName: com.ibm.ws.logging.osgi.fat.wstracehandler; singleton:=true

IBM-Web-Extension-Processing-Disabled: true

Web-ContextPath: /wsTraceHandler

Import-Package: \
    !*.internal.*, \
    *

Export-Package: \
    com.ibm.ws.logging.osgi.fat.wstracehandler

-includeresource: \
    OSGI-INF/permissions.perm=test-bundles/com.ibm.ws.logging.osgi.fat.wstracehandler/resources/OSGI-INF/permissions.perm, \
    WEB-INF=test-bundles/com.ibm.ws.logging.osgi.fat.wstracehandler/resources/WEB-INF

-dsannotations: \
    com.ibm.ws.logging.osgi.fat.wstracehandler.TestWsTraceHandler, \
    com.ibm.ws.logging.osgi.fat.wstracehandler.WsTraceHandlerEndpoint

instrument.disabled: true
