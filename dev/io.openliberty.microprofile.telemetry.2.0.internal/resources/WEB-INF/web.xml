<!DOCTYPE web-app>
<web-app id="MyRESTProxyServlet" version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
  <display-name>MyRESTProxyServlet</display-name>
  <description>test test test</description>

  <servlet>
    <servlet-name>MyRESTProxyServlet</servlet-name>
    <servlet-class>io.openliberty.microprofile.telemetry20.internal.test.rest.MyRESTProxyServlet</servlet-class>
